{
  "name": "@trycompai/utils",
  "version": "1.0.0",
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./devices": {
      "types": "./src/devices.ts",
      "import": "./dist/devices.mjs",
      "require": "./dist/devices.js",
      "default": "./dist/devices.js"
    },
    "./envs": {
      "types": "./src/envs.ts",
      "import": "./dist/envs.mjs",
      "require": "./dist/envs.js",
      "default": "./dist/envs.js"
    },
    "./format": {
      "types": "./src/format.ts",
      "import": "./dist/format.mjs",
      "require": "./dist/format.js",
      "default": "./dist/format.js"
    },
    "./data-masking": {
      "types": "./src/data-masking.ts",
      "import": "./dist/data-masking.mjs",
      "require": "./dist/data-masking.js",
      "default": "./dist/data-masking.js"
    },
    "./sanitize": {
      "types": "./src/sanitize.ts",
      "import": "./dist/sanitize.mjs",
      "require": "./dist/sanitize.js",
      "default": "./dist/sanitize.js"
    }
  },
  "main": "dist/index.js",
  "private": true,
  "scripts": {
    "clean": "rm -rf .turbo node_modules dist",
    "build": "tsup",
    "dev": "tsup --watch",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "sideEffects": false
}
